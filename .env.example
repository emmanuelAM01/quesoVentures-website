# Contact form delivery
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=

# Business picker on the report form. Optional: without it the field is a plain
# text input and the form still works. Enable "Places API (New)" in Google Cloud
# and restrict the key to that API. Autocomplete is billed per request and the
# free monthly tier covers this site's volume many times over.
GOOGLE_PLACES_API_KEY=
