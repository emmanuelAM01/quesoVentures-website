# Inbound report pipeline — where the "get free report" form sends leads.
#
# The portal takes the lead, reads their Google listing, writes the report,
# emails it to them, and alerts Emmanuel — all inside the form submission.
# Without PORTAL_URL the form silently falls back to the Gmail path below,
# which alerts Emmanuel and sends the visitor nothing.
PORTAL_URL=https://portal.quesoventures.com
# Shared secret for the portal's public intake routes. Same value as the
# portal's QUESO_FORMS_SECRET. Server-side only — it must never ship to a
# browser, which is why the form posts to this app's own route first.
QUESO_FORMS_SECRET=

# Fallback lead delivery, used only when the portal cannot be reached.
# Keep it configured: it is the difference between a lost lead and a late one.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=

# Business picker on the report form. Optional: without it the field is a plain
# text input and the form still works. Enable "Places API (New)" in Google Cloud
# and restrict the key to that API. Autocomplete is billed per request and the
# free monthly tier covers this site's volume many times over.
#
# Note this is the *autocomplete* key for this site. The portal holds its own
# key of the same kind for reading the listing behind a place_id.
GOOGLE_PLACES_API_KEY=

# ── The Queso Guide (/guide) ─────────────────────────────────────────────────
# Articles are written in the portal's admin app and read from the portal's
# Supabase project. Same URL and anon key the portal uses. Without these the
# guide renders empty and the rest of the site is unaffected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Reads drafts in preview and writes guide events. Never prefix
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The admin sends these. Each must match the admin project's value exactly.
# Generate with: openssl rand -hex 32
GUIDE_REVALIDATE_SECRET=
GUIDE_PREVIEW_SECRET=

# IndexNow key (8 to 128 letters, digits or hyphens). Served at /{key}.txt by a
# rewrite in next.config.js, so there is no file to add. Generate with:
# openssl rand -hex 16
INDEXNOW_KEY=

# Canonical origin for guide URLs, sitemaps and IndexNow. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.quesoventures.com

# Optional. Microsoft Clarity project id; loads on guide pages only when set.
NEXT_PUBLIC_CLARITY_ID=
